# ============================================================
# Memento
# Next.js + TypeScript + MongoDB + Python/Flask ML service
# ============================================================

# -------------------------
# Node / package managers
# -------------------------
node_modules/
.pnp/
.pnp.js

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep lockfiles committed.
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# -------------------------
# Next.js / frontend build
# -------------------------
.next/
out/
dist/
build/
.turbo/

# Vercel
.vercel/

# Coverage / tests
coverage/
.nyc_output/
playwright-report/
test-results/

# -------------------------
# Environment variables
# -------------------------
.env
.env.*
!.env.example

# Explicit local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# ML service env
ml-service/.env
ml-service/.env.*

# -------------------------
# Python / Flask
# -------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python packaging
*.egg-info/
.eggs/
pip-wheel-metadata/

# -------------------------
# ML artifacts / datasets
# -------------------------
# Trained artifacts should normally be rebuilt or stored via
# release/object storage rather than committed to source.
ml-service/model.joblib
ml-service/model-*.joblib
ml-service/*.joblib
ml-service/*.pkl
ml-service/*.pickle

# Temporary model promotion files
ml-service/*.tmp
ml-service/*.bak

# Training datasets / exports
ml-service/*.csv
ml-service/*.parquet
ml-service/*.jsonl
ml-service/training-data/
ml-service/data/

# Keep manually authored JSON config files elsewhere.
# Do not globally ignore *.json.

# -------------------------
# User imports / temporary uploads
# -------------------------
uploads/
tmp/
temp/
*.zip

# Letterboxd exports should never enter source control.
letterboxd*.zip
letterboxd-export*/
exports/

# -------------------------
# Local databases / caches
# -------------------------
*.sqlite
*.sqlite3
*.db
.cache/

# -------------------------
# Editors / OS
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

.idea/
*.swp
*.swo
*~

# -------------------------
# Logs
# -------------------------
logs/
*.log

# -------------------------
# Misc secrets / certificates
# -------------------------
*.pem
*.key
*.p12
*.pfx
*.crt

# -------------------------
# Local scratch / generated
# -------------------------
scratch/
debug/
resolved_tracks.json
sync_report.csv
